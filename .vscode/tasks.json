{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build JAR (Maven)",
			"type": "shell",
			"command": "mvn",
			"args": [
				"clean",
				"package",
				"-DskipTests"
			],
			"group": "build"
		},
		{
			"label": "Install to Local Maven Repo",
			"type": "shell",
			"command": "mvn",
			"args": [
				"clean",
				"install",
				"-DskipTests"
			],
			"group": "build"
		}
	]
}